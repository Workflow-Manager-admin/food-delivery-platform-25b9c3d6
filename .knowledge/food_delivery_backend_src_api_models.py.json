ant, item IDs, and delivery address."}, {"name": "Order", "description": "Order schema with full details including status, total, timestamps, and optional delivery info."}, {"name": "Payment", "description": "Schema representing payment details for an order."}, {"name": "Delivery", "description": "Delivery info linked to an order, including driver, status, location."}, {"name": "ReviewCreate", "description": "Schema for submitting a review."}, {"name": "Review", "description": "Review data including rating, comment, and timestamps."}, {"name": "Notification", "description": "Notification message schema."}], "calls": ["Order.update_forward_refs()"], "search-terms": ["pydantic models", "food delivery schema", "order model", "restaurant data model", "user profile schema"], "state": 2, "file_id": 5, "knowledge_revision": 33, "git_revision": "7a9104a3e0a812f7a559e89ff1b96a8f2bc4d5cf", "revision_history": [{"12": ""}, {"33": "7a9104a3e0a812f7a559e89ff1b96a8f2bc4d5cf"}], "ctags": [{"_type": "tag", "name": "Delivery", "path": "/home/kavia/workspace/code-generation/food-delivery-platform-25b9c3d6/food_delivery_backend/src/api/models.py", "pattern": "/^class Delivery(BaseModel):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "Menu", "path": "/home/kavia/workspace/code-generation/food-delivery-platform-25b9c3d6/food_delivery_backend/src/api/models.py", "pattern": "/^class Menu(MenuBase):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "MenuBase", "path": "/home/kavia/workspace/code-generation/food-delivery-platform-25b9c3d6/food_delivery_backend/src/api/models.py", "pattern": "/^class MenuBase(BaseModel):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "MenuItem", "path": "/home/kavia/workspace/code-generation/food-delivery-platform-25b9c3d6/food_delivery_backend/src/api/models.py", "pattern": "/^class MenuItem(MenuItemBase):$/", "language": "Python", "kind": "class"}, {"_type": "tag", "name": "MenuItemBase", "pat